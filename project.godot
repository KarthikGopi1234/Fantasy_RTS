; Engine configuration file.
; Aether Empires v2.1.0 - Idle Auto-Battler Portrait Polish

config_version=5

[application]

run/main_scene="res://scenes/Splash.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.0784314, 0.117647, 0.215686, 1)
config/name="Aether Empires"
config/version="2.1.0"

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
ResourceManager="*res://scripts/autoload/ResourceManager.gd"
TechTree="*res://scripts/autoload/TechTree.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
IdleManager="*res://scripts/autoload/IdleManager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/resizable=false
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/handheld/orientation=2
window/vsync/vsync_mode=0
window/size/window_width_override=720
window/size/window_height_override=1280

[boot_splash]

bg_color=Color(0.0784314, 0.117647, 0.215686, 1)
show_image=false

[input]

tap={
