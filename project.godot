, Object(InputEventScreenTouch,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"command_or_control_automap":false,"control_pressed":false,"meta_pressed":false,"index":0,"pressed":false,"position":Vector2(0, 0),"script":null)
]
}
